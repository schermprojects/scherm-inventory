generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Equipment {
  id            String             @id @default(cuid())
  name          String
  category      String
  manufacturer  String?
  model         String?
  serialNumber  String?
  quantity      Int                @default(1)
  minimumStock  Int                @default(0)
  invoiceNumber String?
  status        EquipmentStatus    @default(AVAILABLE)
  condition     EquipmentCondition @default(NEW)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  images   EquipmentImage[]
  projects ProjectEquipment[]

  @@index([name])
  @@index([category])
  @@index([status])
  @@index([condition])
  @@map("equipment")
}

model EquipmentImage {
  id          String   @id @default(cuid())
  url         String
  downloadUrl String?
  pathname    String
  contentType String?
  size        Int?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@map("equipment_images")
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         UserRole @default(VIEWER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdProjects     Project[] @relation("ProjectCreatedBy")
  responsibleProjects Project[] @relation("ProjectResponsible")
  salesProjects       Project[] @relation("ProjectSalesperson")

  @@index([name])
  @@index([role])
  @@index([active])
  @@map("users")
}

model Project {
  id          String          @id @default(cuid())
  name        String
  clientName  String?
  description String?
  status      ProjectStatus   @default(PLANNING)
  priority    ProjectPriority @default(NORMAL)
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  notes       String?

  createdById   String?
  responsibleId String?
  salespersonId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User? @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  responsible User? @relation("ProjectResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  salesperson User? @relation("ProjectSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)

  equipment ProjectEquipment[]

  @@index([name])
  @@index([clientName])
  @@index([status])
  @@index([priority])
  @@index([createdById])
  @@index([responsibleId])
  @@index([salespersonId])
  @@index([dueDate])
  @@map("projects")
}

model ProjectEquipment {
  id          String   @id @default(cuid())
  quantity    Int      @default(1)
  notes       String?
  projectId   String
  equipmentId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  @@unique([projectId, equipmentId])
  @@index([projectId])
  @@index([equipmentId])
  @@map("project_equipment")
}

enum UserRole {
  ADMIN
  COMMERCIAL
  VIEWER
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  UNAVAILABLE
}

enum EquipmentCondition {
  NEW
  DAMAGED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}
