generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Equipment {
  id                 String             @id @default(cuid())
  name               String
  category           String
  manufacturer       String?
  model              String?
  serialNumber       String?
  quantity           Int                @default(1)
  installedQuantity  Int                @default(0)
  damagedQuantity    Int                @default(0)
  minimumStock       Int                @default(0)
  invoiceNumber      String?
  status             EquipmentStatus    @default(AVAILABLE)
  condition          EquipmentCondition @default(NEW)
  // O RMA representa o processo administrativo da peça danificada.
  // rmaNotes registra a abertura; rmaResolutionNotes registra a decisão/fechamento.
  // Uma substituição cria outro Equipment físico e preserva o serial original.
  rmaStatus          EquipmentRmaStatus @default(NONE)
  rmaReference       String?
  rmaNotes           String?
  rmaResolutionNotes String?
  rmaOpenedAt        DateTime?
  rmaClosedAt        DateTime?

  rmaReplacementEquipmentId String?
  rmaReplacementEquipment   Equipment?  @relation("RmaReplacement", fields: [rmaReplacementEquipmentId], references: [id])
  replacedRmaEquipment      Equipment[] @relation("RmaReplacement")

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements         EquipmentMovement[]
  images            EquipmentImage[]
  projects          ProjectEquipment[]
  machineComponents MachineComponent[]
  machines          Machine[]           @relation("MachineEquipment")
  equipmentUnits    EquipmentUnit[]

  @@index([name])
  @@index([category])
  @@index([status])
  @@index([condition])
  @@index([rmaStatus])
  @@index([damagedQuantity])
  @@map("equipment")
}

model EquipmentUnit {
  id String @id @default(cuid())

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Restrict)

  serialNumber String @unique

  condition EquipmentUnitCondition @default(OPERATIONAL)

  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  movements         EquipmentUnitMovement[]
  projectAssignment ProjectEquipmentUnit?

  @@index([equipmentId])
  @@index([condition])
  @@map("equipment_units")
}

model EquipmentImage {
  id          String   @id @default(cuid())
  url         String
  downloadUrl String?
  pathname    String
  contentType String?
  size        Int?
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId])
  @@map("equipment_images")
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         UserRole @default(VIEWER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdProjects     Project[]                  @relation("ProjectCreatedBy")
  responsibleProjects Project[]                  @relation("ProjectResponsible")
  salesProjects       Project[]                  @relation("ProjectSalesperson")
  equipmentMovements  EquipmentMovement[]        @relation("EquipmentMovementCreatedBy")
  auditLogs           AuditLog[]
  createdMachines     Machine[]                  @relation("MachineCreatedBy")
  componentMovements  MachineComponentMovement[] @relation("MachineComponentMovementCreatedBy")

  @@index([name])
  @@index([role])
  @@index([active])
  @@map("users")
}

model Client {
  id String @id @default(cuid())

  shortName  String?
  clientCode String? @unique

  name        String
  contactName String
  position    String?

  phone    String?
  mobile   String?
  email    String?
  website  String?
  document String?

  zipcode    String?
  address    String?
  number     String?
  complement String?
  district   String?
  city       String?
  state      String?

  notes  String?
  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@index([name])
  @@index([shortName])
  @@index([contactName])
  @@index([city])
  @@index([active])
  @@map("clients")
}

model Project {
  id              String          @id @default(cuid())
  name            String
  clientName      String?
  clientId        String?
  description     String?
  status          ProjectStatus   @default(PLANNING)
  priority        ProjectPriority @default(NORMAL)
  startDate       DateTime?
  dueDate         DateTime?
  completedAt     DateTime?
  stockDeductedAt DateTime?
  notes           String?

  createdById   String?
  responsibleId String?
  salespersonId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdBy User? @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  responsible User? @relation("ProjectResponsible", fields: [responsibleId], references: [id], onDelete: SetNull)

  salesperson User? @relation("ProjectSalesperson", fields: [salespersonId], references: [id], onDelete: SetNull)

  client Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  equipment              ProjectEquipment[]
  equipmentMovements     EquipmentMovement[]
  equipmentUnitMovements EquipmentUnitMovement[]

  @@index([name])
  @@index([clientName])
  @@index([clientId])
  @@index([status])
  @@index([priority])
  @@index([createdById])
  @@index([responsibleId])
  @@index([salespersonId])
  @@index([dueDate])
  @@index([stockDeductedAt])
  @@map("projects")
}

model ProjectEquipment {
  id                String          @id @default(cuid())
  quantity          Int             @default(1)
  reservedQuantity  Int             @default(0)
  allocatedQuantity Int             @default(0)
  purchaseStatus    PurchaseStatus?
  notes             String?
  projectId         String
  equipmentId       String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  equipment      Equipment              @relation(fields: [equipmentId], references: [id], onDelete: Restrict)
  equipmentUnits ProjectEquipmentUnit[]

  @@unique([projectId, equipmentId])
  @@index([projectId])
  @@index([equipmentId])
  @@map("project_equipment")
}

model ProjectEquipmentUnit {
  id String @id @default(cuid())

  projectEquipmentId String
  projectEquipment   ProjectEquipment @relation(fields: [projectEquipmentId], references: [id], onDelete: Cascade)

  equipmentUnitId String        @unique
  equipmentUnit   EquipmentUnit @relation(fields: [equipmentUnitId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([projectEquipmentId])
  @@map("project_equipment_units")
}

model EquipmentMovement {
  id String @id @default(cuid())

  type     EquipmentMovementType
  quantity Int

  previousQuantity Int
  currentQuantity  Int

  invoiceNumber String?
  notes         String?

  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("EquipmentMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([equipmentId])
  @@index([projectId])
  @@index([createdById])
  @@index([createdAt])
}

model EquipmentUnitMovement {
  id String @id @default(cuid())

  type EquipmentUnitMovementType

  equipmentUnitId String
  equipmentUnit   EquipmentUnit @relation(fields: [equipmentUnitId], references: [id], onDelete: Restrict)

projectId String?
project   Project? @relation(fields: [projectId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@index([equipmentUnitId])
  @@index([projectId])
  @@index([type])
  @@index([createdAt])
  @@map("equipment_unit_movements")
}

model Machine {
  id String @id @default(cuid())

  name         String
  category     String?
  manufacturer String?
  model        String?

  assetTag      String? @unique
  serialNumber  String  @unique
  invoiceNumber String?

  receivedAt DateTime?

  status MachineStatus @default(AVAILABLE)

  notes String?

  equipmentId String? @unique

  equipment Equipment? @relation("MachineEquipment", fields: [equipmentId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("MachineCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  components MachineComponent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([manufacturer])
  @@index([model])
  @@index([status])
  @@index([createdById])
  @@map("machines")
}

model MachineComponent {
  id String @id @default(cuid())

  machineId String
  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  equipmentId String?
  equipment   Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  name         String
  category     String
  manufacturer String?
  model        String?

  serialNumber String?

  quantity Int @default(1)

  status MachineComponentStatus @default(INSTALLED)

  installedAt DateTime  @default(now())
  removedAt   DateTime?

  notes String?

  movements MachineComponentMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([machineId])
  @@index([equipmentId])
  @@index([serialNumber])
  @@index([category])
  @@index([status])
  @@index([removedAt])
  @@map("machine_components")
}

model MachineComponentMovement {
  id String @id @default(cuid())

  type MachineComponentMovementType

  machineComponentId String
  machineComponent   MachineComponent @relation(fields: [machineComponentId], references: [id], onDelete: Restrict)

  reason MachineComponentMovementReason
  notes  String?

  createdById String?
  createdBy   User?   @relation("MachineComponentMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([machineComponentId])
  @@index([type])
  @@index([reason])
  @@index([createdById])
  @@index([createdAt])
  @@map("machine_component_movements")
}

model AuditLog {
  id String @id @default(cuid())

  action AuditAction
  entity AuditEntity

  entityId String?

  description String

  oldData Json?
  newData Json?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([action])
  @@index([entity])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

enum UserRole {
  ADMIN
  BACKOFFICE
  COMMERCIAL
  VIEWER
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  UNAVAILABLE
}

enum EquipmentCondition {
  NEW
  REPAIRED
  DAMAGED
}

enum EquipmentRmaStatus {
  NONE
  PENDING
  SENT
  APPROVED
  REJECTED
  RETURNED
  REPLACED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EquipmentMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  RETURN
  DAMAGED_RETURN
}

enum EquipmentUnitMovementType {
  EXIT
  RETURN
}

enum EquipmentUnitCondition {
  OPERATIONAL
  DAMAGED
}

enum MachineStatus {
  HOMOLOGATION
  AVAILABLE
  IN_USE
  MAINTENANCE
  UNAVAILABLE
  RETIRED
}

enum MachineComponentStatus {
  INSTALLED
  REMOVED
  DAMAGED
  MAINTENANCE
  DISCARDED
}

enum MachineComponentMovementType {
  INSTALL
  REMOVE
}

enum MachineComponentMovementReason {
  INITIAL_ASSEMBLY
  UPGRADE
  HARDWARE_FAILURE
  MAINTENANCE
  PREVENTIVE_REPLACEMENT
  REALLOCATION
  RETURN
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  STOCK_ENTRY
  STOCK_EXIT
  ALLOCATE
  DEALLOCATE
}

enum AuditEntity {
  USER
  CLIENT
  PROJECT
  EQUIPMENT
  MACHINE
  MACHINE_COMPONENT
  PURCHASE
  MOVEMENT
}
enum PurchaseStatus {
  REQUESTED
  ACQUIRED
}